<div id="<%= dom_id recipe %>">
  <div>
    <strong>Title:</strong>
    <%= recipe.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= recipe.description %>
  </div>

  <div>
    <strong>Prep time:</strong>
    <%= recipe.prep_time %>
  </div>

  <div>
    <strong>Servings:</strong>
    <%= recipe.servings %>
  </div>

</div>
